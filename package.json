{
	"name": "api",
	"version": "1.0.0",
	"description": "",
	"repository": {
		"type": "git",
		"url": "https://github.com/mryan-code/Storm-Zero-Backend.git"
	},
	"license": "ISC",
	"author": "",
	"type": "commonjs",
	"main": "index.js",
	"scripts": {
		"build": "tsc && npm run copy-files",
		"start": "node dist/index.js",
		"start:pm2": "node scripts/start-pm2.js",
		"stop": "node scripts/stop.js",
		"stop:pm2": "node scripts/stop-pm2.js",
		"background": "node dist/index.js >> '/dev/null' 2>&1 &",
		"dev": "nodemon --legacy-watch -e js,ts,json --watch 'src/**/*.ts' --watch 'src/**/*.js' --watch '*.json' --exec \"bash -lc 'clear; npm run copy-files && FORCE_COLOR=3 ts-node src/index.ts 2>&1 | ts \\\"[%Y-%m-%d %H:%M:%S]\\\"'\"",
		"dev:setup": "node scripts/dev-setup.js",
		"dev:test": "node scripts/dev-test-setup.js",
		"start:test": "node scripts/start-test-setup.js",
		"lint": "eslint 'src/**/*.ts'",
		"copy-files": "copyfiles -u 1 src/**/*.html src/**/*.css src/**/*.js dist/",
		"debug": "grep -E '(debug 4.4.2|backslash|chalk-template|supports-hyperlinks|has-ansi|simple-swizzle|color-string|error-ex|color-name 2.0.1|is-arrayish|slice-ansi|color-convert 3.1.1|wrap-ansi 9.0.1|ansi-regex 6.2.1|supports-color 10.2.1|strip-ansi 7.1.1|chalk 5.6.1|ansi-styles 6.2.2)' package-lock.json",
		"ngrok": "ngrok http http://localhost:9876",
		"test": "jest --maxWorkers=25%",
		"test:watch": "jest --watch",
		"test:coverage": "jest --coverage"
	},
	"dependencies": {
		"@fingerprintjs/fingerprintjs": "^5.2.0",
		"@huggingface/hub": "^2.13.2",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/node": "^22.19.21",
		"@types/swagger-ui-express": "^4.1.8",
		"@types/ws": "^8.18.1",
		"axios": "^1.18.0",
		"body-parser": "^2.3.0",
		"chalk": "^5.6.2",
		"copyfiles": "^2.4.1",
		"cors": "^2.8.6",
		"cron": "^4.4.0",
		"dayjs": "^1.11.21",
		"dotenv": "^17.4.2",
		"eslint": "^10.5.0",
		"express": "^5.2.1",
		"express-form-data": "^3.0.1",
		"fastify-helmet": "^7.1.0",
		"file-type": "^22.0.1",
		"jsonwebtoken": "^9.0.3",
		"kokoro-js": "^1.2.1",
		"moment": "^2.30.1",
		"moment-timezone": "^0.6.2",
		"multer": "^2.2.0",
		"nodemailer": "^9.0.3",
		"nodemon": "^3.1.14",
		"pathe": "^2.0.3",
		"pg": "^8.16.3",
		"pg-hstore": "^2.3.4",
		"sequelize": "^6.37.8",
		"sqlite3": "^6.0.1",
		"swagger-ui-express": "^5.0.1",
		"ts-node": "^10.9.2",
		"typescript": "^5.9.3",
		"uuid": "^11.1.1",
		"web-push": "^3.6.7",
		"ws": "^8.21.0"
	},
	"devDependencies": {
		"@types/express-form-data": "^2.0.5",
		"@types/jest": "^30.0.0",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/multer": "^2.1.0",
		"jest": "^30.4.2",
		"ts-jest": "^29.4.11"
	},
	"overrides": {
		"js-yaml": "^4.2.0",
		"sequelize": {
			"uuid": "^11.1.1"
		}
	}
}
